layout(local_size_x = 8, local_size_y = 8) in;

// The guide buffers ray reconstruction consumes, built from the first path vertex exactly as
// pt_main.rgen hands it over: a copy of the G-buffer on ordinary pixels, and on a metallic
// mirror the surface seen through it (Primary Surface Replacement), with the mirror chain's
// reflectance in the throughput image. The denoiser and the tracer describe one surface.
//
//  - diffuse albedo and specular albedo are what the radiance is demodulated by before
//    the kernels run and multiplied back by afterwards, so they have to be the exact split
//    deferred_lighting.frag shades with or the demodulated signal stops being flat. Both are
//    scaled by the throughput: on a replaced pixel the radiance carries the mirror's tint too;
//  - normal and roughness share one RGBA16F in the layout sl_dlss_d.h calls
//    DLSSDNormalRoughnessMode::ePacked - "App needs to write Roughness to w channel of
//    Normal resource" - which is the mode EvaluateRayReconstruction selects.
#include "common.glsl"
#include "utils.glsl"

// Albedo in rgb, metallic in a.
layout(set = 1, binding = 0) uniform sampler2D primaryAlbedoTexture;
// World normal in xyz, roughness in w.
layout(set = 1, binding = 1) uniform sampler2D primaryNormalTexture;
// Reversed-Z, the virtual point's depth on a replaced pixel.
layout(set = 1, binding = 2) uniform sampler2D depthTexture;
// Float: both are scaled by the throughput, and a dark mirror tint bands in 8 bits.
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D outDiffuseAlbedo;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D outSpecularAlbedo;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D outNormalRoughness;
// The split-sum environment BRDF table, the same image lighting_common.glsl samples at set 3
// binding 2 and with the same (NdotV, roughness) convention.
layout(set = 1, binding = 6) uniform sampler2D iblBrdfLut;
// Mirror chain reflectance in rgb, 1 in a where the surface has a PBR response.
layout(set = 1, binding = 7) uniform sampler2D primaryThroughputTexture;

// Reversed-Z: the sky is exactly zero and every surface is above it.
const float GUIDE_SKY_DEPTH = 0.0;

// Section 3.4.2 of the DLSS-RR Integration Guide, verbatim: the recommended specular albedo
// for a pixel with no surface behind it. Shared with the non-PBR branch below, which has the
// same problem - a shading model that gave up its PBR response still has to hand the
// denoiser a divisor it can multiply back.
const vec3 GUIDE_SKY_SPECULAR_ALBEDO = vec3(0.5);

void main()
{
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (pixel.x >= u_Frame.screenWidth || pixel.y >= u_Frame.screenHeight)
    return;

  float depth = texelFetch(depthTexture, pixel, 0).r;
  vec4 throughput = texelFetch(primaryThroughputTexture, pixel, 0);

  // A pixel with no PBR response to demodulate: the sky, an unlit texel whose albedo IS
  // its final colour, and an emissive one that gave up its response in the G-buffer pass.
  // Zero diffuse albedo tells the denoiser to carry the radiance through untouched instead
  // of dividing it by something that never scaled it. The tagged depth buffer says the same
  // thing a second time - reversed-Z puts the sky at exactly zero - so a build that reads
  // the sky out of depth rather than out of the albedos gets a consistent answer.
  //
  // The specular guide is the exception, and it is named in the guide rather than reasoned
  // out: section 3.4.2 of NVIDIA's DLSS-RR Integration Guide calls uncleared sky pixels "a
  // common integration error" and states that "a good default albedo for sky is
  // (0.5, 0.5, 0.5)". Zero is not the neutral value here - it is the worst possible divisor
  // for a demodulation step. Seen through a mirror, the sky arrives tinted by it, so the
  // default is tinted the same way.
  if (depth <= GUIDE_SKY_DEPTH)
  {
    imageStore(outDiffuseAlbedo, pixel, vec4(0.0));
    imageStore(outSpecularAlbedo, pixel, vec4(GUIDE_SKY_SPECULAR_ALBEDO * throughput.rgb, 1.0));
    // No surface, so no lobe for the kernels to shape: a flat normal at full roughness is
    // the widest, least confident filter, which is what a sky pixel should get.
    imageStore(outNormalRoughness, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    return;
  }

  vec4 normalRoughness = texelFetch(primaryNormalTexture, pixel, 0);
  vec3 normal = normalRoughness.xyz;

  if (throughput.a < 0.5)
  {
    imageStore(outDiffuseAlbedo, pixel, vec4(0.0));
    imageStore(outSpecularAlbedo, pixel, vec4(GUIDE_SKY_SPECULAR_ALBEDO * throughput.rgb, 1.0));
    imageStore(outNormalRoughness, pixel, vec4(normal, 1.0));
    return;
  }

  vec4 material = texelFetch(primaryAlbedoTexture, pixel, 0);
  vec3 albedo = material.rgb;
  float metallic = material.a;
  float roughness = normalRoughness.w;

  // A metal has no diffuse lobe at all, and f0 is the one Fresnel base every lighting path
  // in the engine builds - deferred_lighting.frag, forward_transparent.frag, ssr.frag and
  // pt_main.rgen all spell it exactly this way.
  vec3 diffuseAlbedo = albedo * (1.0 - metallic);
  vec3 f0 = mix(vec3(0.04), albedo, metallic);

  // The specular guide is a REFLECTANCE, not a Fresnel base, and the difference is what
  // wrecked Bistro's exterior glass. Ray reconstruction demodulates specular radiance by this
  // image before it filters and multiplies it back afterwards, so writing flat f0 tells the
  // denoiser a black dielectric reflects 4% of everything from every angle. It does not: at
  // grazing incidence its reflectance approaches one, an order of magnitude more, and
  // dividing a large signal by a guide ten times too small is exactly the amplified garbage
  // that showed up - localized to dark smooth dielectrics, because that is where f0 and the
  // real reflectance diverge most.
  //
  // The split-sum environment BRDF is the directional-hemispherical reflectance of the GGX
  // lobe and is what the engine already has a table for: A scales f0, B is the grazing lift
  // that carries a dark dielectric up on its own. Same LUT and same (NdotV, roughness) lookup
  // as shadeSpecularIBL.
  //
  // Two deliberate departures from that function, both because this is a guide and not a
  // shaded term: it is f0 that is scaled here rather than fresnelSchlickRoughness, since A
  // and B were fitted for the f0 * A + B form and feeding an already roughness-biased Fresnel
  // through them counts roughness twice; and shadeSpecularIBL's (1 - 0.8 * roughness) rolloff
  // is left out, being an artistic energy trim rather than part of the reflectance the tracer
  // actually produces.
  //
  // The view vector only depends on the pixel's camera ray, and a replaced surface's virtual
  // point lies on that same ray. Its normal was mirrored back through the chain, and a
  // reflection preserves the angle to the ray, so this NdotV is the one the tracer saw at the
  // real hit.
  vec2 uv = (vec2(pixel) + 0.5) / vec2(u_Frame.screenWidth, u_Frame.screenHeight);
  vec3 viewPos = reconstructViewPos(uv, depth);
  vec3 worldPos = (u_Frame.invView * vec4(viewPos, 1.0)).xyz;
  vec3 viewVec = normalize(u_Frame.cameraPosition - worldPos);
  // The clamp deferred_lighting.frag applies to its own NdotV, so the two agree at the edges.
  float NdotV = clamp(abs(dot(normal, viewVec)), 0.01, 0.99);

  vec2 envBrdf = texture(iblBrdfLut, vec2(NdotV, clamp(roughness, 0.01, 0.99))).rg;
  // The bias term is faded out as the base reflectance approaches zero, which is the one part
  // of NVIDIA's own EnvBRDFApprox2 (appendix of the DLSS-RR Integration Guide) that is not
  // just a different fit of the same integral: "this is a hack for specular reflectance of
  // 0", written there as bias *= saturate(SpecularColor.g * 50). Without it a surface with no
  // specular response at all still reports the full grazing lift, and the denoiser divides by
  // a reflectance the tracer never produced. The green channel is what the reference reads,
  // luminance living mostly there.
  float biasFade = clamp(f0.g * 50.0, 0.0, 1.0);
  vec3 specularAlbedo = f0 * envBrdf.x + vec3(envBrdf.y * biasFade);

  imageStore(outDiffuseAlbedo, pixel, vec4(diffuseAlbedo * throughput.rgb, 1.0));
  imageStore(outSpecularAlbedo, pixel, vec4(specularAlbedo * throughput.rgb, 1.0));
  imageStore(outNormalRoughness, pixel, vec4(normal, roughness));
}
