#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

#define RT_BINDLESS
#include "raytracing_common.glsl"

hitAttributeEXT vec2 hitBarycentrics;

// The alpha cutout a raster draw resolves into pipeline state, for every surface ray. Reached for
// the instances the TLAS left non-opaque - the alpha-tested ones and the dielectrics - and only when
// the ray was not traced with gl_RayFlagsOpaqueEXT, which
// forces every candidate opaque and skips this entirely. A dielectric is a surface like any other to
// a surface ray and is accepted as it is: what it transmits is the ray generation shader's business.
//
// No payload is declared: an any-hit shader that only accepts or rejects a candidate never
// touches one, and leaving it out keeps this callable from any trace whatever its payload
// looks like.
void main()
{
  RayTracingInstanceRecord instance = u_Instances[gl_InstanceCustomIndexEXT];
  if ((instance.flags & RT_INSTANCE_ALPHA_TEST) != 0u
    && isAlphaCutout(instance, uint(gl_PrimitiveID), hitBarycentrics))
    ignoreIntersectionEXT;
}
