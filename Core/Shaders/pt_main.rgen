#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

// The whole path tracer: one sample per pixel per frame, the bounce loop iterative and
// entirely in ray generation - see pt_path.glsl - so the hit and miss shaders stay the thin
// ones pathtrace.rchit/.rmiss already are and the pipeline needs a recursion depth of one.
//
// The first path vertex is NOT traced. It is read back out of the G-buffer, which means the
// tracer starts from exactly the surface the raster pipeline shaded, sub-pixel jitter
// included, and the two images are comparable pixel for pixel instead of only statistically.
// What ray reconstruction is told about that vertex is written separately (outPrimary*,
// outPTDepth, outPTMotion): a copy of the G-buffer, except on metallic delta mirrors, where
// Primary Surface Replacement describes the surface seen through the mirror instead.
//
// Glass is the exception. The G-buffer holds no transparent surface, so the camera ray is traced
// against the glass in front of the G-buffer surface - see main.
//
// Always bindless: every bounce resolves its material through the texture table, so there is
// no non-bindless permutation to be.
#define RT_BINDLESS
#include "raytracing_common.glsl"
#include "utils.glsl"
#include "octahedron.glsl"
#include "pbr.glsl"
#include "random.glsl"
#include "light_eval.glsl"
#include "../Shared/PathTraceData.h"
#include "../Shared/EmissiveLightData.h"
#include "specular_motion.glsl"

// Set 1 bindings 3 and up are the pass's own: the G-buffer, the sky, the lights and the
// outputs. Bindings 0-2 are the scene, declared once in raytracing_common.glsl.
layout(set = 1, binding = 3) uniform sampler2D u_GBuffer0;
layout(set = 1, binding = 4) uniform sampler2D u_GBuffer1;
layout(set = 1, binding = 5) uniform sampler2D u_Depth;
// The same cubemap deferred lighting samples for its sky pixels, so the horizon behind a
// traced image and behind the rasterized one is one texture, not two.
layout(set = 1, binding = 6) uniform samplerCube u_Skybox;

layout(std430, set = 1, binding = 7) readonly buffer PathTraceLightSSBO
{
  LightBuffer u_Lights;
};

// Radiance in rgb, primary hit distance in alpha. Stage 5's ray reconstruction wants the
// distance next to the colour, and it costs nothing to write here.
layout(set = 1, binding = 8, rgba16f) uniform writeonly image2D outNoisy;
// Read-modify-write, unlike everything else the engine stores into: the running mean lives
// in the image itself rather than in a second buffer the CPU would have to ping-pong.
layout(set = 1, binding = 9, rgba32f) uniform image2D outAccumulation;
// The same primary hit distance the alpha above carries, in an image of its own because a
// Streamline tag names one resource and cannot point at a channel of another. Two bytes per
// pixel and one store, next to a value this shader has already computed.
layout(set = 1, binding = 10, r16f) uniform writeonly image2D outHitDistance;
// The alternative ray reconstruction specular guide to the hit distance above, in MainVelocity's
// convention - see specular_motion.glsl. Which of the two is tagged is the panel's choice.
layout(set = 1, binding = 11, rg16f) uniform writeonly image2D outSpecularMotion;
// Read where the virtual image sits on the surface itself: unlit and emissive texels.
layout(set = 1, binding = 12) uniform sampler2D u_MainVelocity;
// The first path vertex as ray reconstruction is told about it - see Render.h. A copy of the
// G-buffer everywhere except where Primary Surface Replacement describes what a delta chain shows.
layout(set = 1, binding = 13, rgba8) uniform writeonly image2D outPrimaryAlbedo;
layout(set = 1, binding = 14, rgba16f) uniform writeonly image2D outPrimaryNormal;
layout(set = 1, binding = 15, rgba16f) uniform writeonly image2D outPrimaryThroughput;
layout(set = 1, binding = 16, r32f) uniform writeonly image2D outPTDepth;
layout(set = 1, binding = 17, rg16f) uniform writeonly image2D outPTMotion;
// The reflection layer: the mirror path of a smooth dielectric or glass first vertex, denoised by
// a second RR instance, and that instance's first vertex, PSR-style on layer pixels and a copy of
// the primary one elsewhere.
layout(set = 1, binding = 18, rgba16f) uniform writeonly image2D outLayerRadiance;
layout(set = 1, binding = 19, rgba8) uniform writeonly image2D outLayerAlbedo;
layout(set = 1, binding = 20, rgba16f) uniform writeonly image2D outLayerNormal;
layout(set = 1, binding = 21, rgba16f) uniform writeonly image2D outLayerThroughput;
layout(set = 1, binding = 22, r32f) uniform writeonly image2D outLayerDepth;
layout(set = 1, binding = 23, rg16f) uniform writeonly image2D outLayerMotion;

// The emissive light table next event estimation samples emitting geometry from, see
// EmissiveLightData.h. Built with this frame slot's instance records.
layout(std430, set = 1, binding = 24) readonly buffer PathTraceEmissiveLightSSBO
{
  EmissiveLightTableHeader u_EmissiveHeader;
  EmissiveLightRecord u_EmissiveLights[];
};

// The forward transparent layer, premultiplied, drawn with this frame's jittered camera at render
// resolution, read only while PathTraceConstants::transparentLayer is set; and the sample as it was
// before the layer went in, ray reconstruction's kBufferTypeColorBeforeTransparency.
layout(set = 1, binding = 25) uniform sampler2D u_TransparentLayer;
layout(set = 1, binding = 26, rgba16f) uniform writeonly image2D outColorBeforeTransparency;

// The surface under a clear coat texel, read unfiltered, see clear_coat.glsl.
layout(set = 1, binding = 27) uniform sampler2D u_GBuffer2;

layout(push_constant) uniform PathTracePushBlock
{
  PathTraceConstants pc;
};

layout(location = 0) rayPayloadEXT RayTracingPayload payload;
layout(location = 1) rayPayloadEXT ShadowRayPayload shadowPayload;

#include "pt_path.glsl"

// Reversed-Z: the sky is exactly zero and everything else is above it.
const float PT_SKY_DEPTH = 0.0;

// The first vertex as one ray reconstruction instance is told about it, see Render.h.
struct FirstVertexGuides
{
  // Albedo in rgb, metallic in a.
  vec4 albedo;
  // World normal in xyz, roughness in w.
  vec4 normal;
  // The delta chain's throughput in rgb, 1 in a where the surface has a PBR response.
  vec4 throughput;
  // Reversed-Z.
  float depth;
  // MainVelocity's convention.
  vec2 motion;
};

// The reversed-Z depth the depth prepass would have written at a world space point. The jitter
// in the projection moves x and y only.
float projectDepth(vec3 worldPosition)
{
  vec4 clip = u_Frame.proj * (u_Frame.view * vec4(worldPosition, 1.0));
  return clip.w > 0.0 ? clip.z / clip.w : PT_SKY_DEPTH;
}

// Primary Surface Replacement - see PT_PSR_MIN_METALLIC - as a walk along a delta chain: through
// every metallic delta mirror, reflected, and every Solid the chain refracts at, transmitted, to the
// first surface that is neither. The guides are rewritten to describe that surface as a virtual
// surface on the camera ray: its material, its normal mirrored back through every mirror (which keeps
// the angle to the camera ray the real hit had), the chain's throughput, and the depth and motion of
// the virtual point. The radiance estimator is not touched.
//
// The chain meets glass by the estimator's own rules for the same rays: settings and refractRole give
// how a Solid is met at each link from the refractive events spent so far (solidTreatment), and glass
// crossed straight is passed as traceSegment passes it, its transmittance in the throughput.
//
// The chain starts with a segment the caller already traced from chainStart and passed straight glass
// on, its transmittance in throughput - hitPayload is its hit - which lies startDistance along the camera ray
// cameraDirection; a mirror at chainStart itself comes in as mirror 0 with mirrorCount 1. maxMirrors,
// the first one included, is what the estimator's bounce budget still sees through. depthScale is
// depth times distance, constant along a camera ray under reversed-Z.
//
// A mirror is exact: the virtual point is the real hit unfolded through every mirror plane. A solid
// dielectric bends the chain, so once one has, the virtual point is taken on the camera ray at the
// chain's length instead, as if every refraction had gone straight on, and moves with the instance
// it lands on; the mirrors are still unfolded exactly around it. A dielectric that totally reflects,
// or one the chain may not refract at, ends the chain on itself, described as a smooth surface.
//
// A segment the estimator gathers analytic lights on - one past a delta vertex: the G-buffer vertex
// where startGathers says so, and every mirror of the chain - ends the chain on the nearest sphere
// light it enters before its hit (nearestSphereLight), described as an emitter and as a static point:
// the light buffer keeps no previous positions, so a moving light's glint trails. The start segment's
// light, startLight (-1 for none) with its centre, comes from the caller, which has tested it already.
void replacePrimarySurface(vec3 chainStart, vec3 rayOrigin, vec3 direction,
  RayTracingPayload hitPayload, float startLight, vec3 startLightCenter, bool startGathers,
  float startDistance, float depthScale,
  vec3 cameraDirection, vec3 throughput, int mirrorCount, int maxMirrors, vec3 firstMirrorNormal,
  vec3 firstPreviousMirrorPoint, vec3 firstPreviousMirrorNormal, MediumStack media,
  PathSettings settings, bool refractRole, int transmissions, vec2 currentNDC,
  inout FirstVertexGuides guides)
{
  // Every mirror of the chain in chain order, and its plane as of the previous frame.
  vec3 mirrorNormals[PT_PSR_MAX_CHAIN_DEPTH];
  vec3 mirrorPoints[PT_PSR_MAX_CHAIN_DEPTH];
  vec3 previousMirrorPoints[PT_PSR_MAX_CHAIN_DEPTH];
  vec3 previousMirrorNormals[PT_PSR_MAX_CHAIN_DEPTH];
  mirrorNormals[0] = firstMirrorNormal;
  mirrorPoints[0] = chainStart;
  previousMirrorPoints[0] = firstPreviousMirrorPoint;
  previousMirrorNormals[0] = firstPreviousMirrorNormal;
  maxMirrors = min(PT_PSR_MAX_CHAIN_DEPTH, maxMirrors);
  bool bent = false;

  float chainDistance = startDistance;
  vec3 segmentBase = chainStart;
  // Where the segment's ray actually left from, which hitT is measured against.
  vec3 segmentOrigin = rayOrigin;

  int solid = solidTreatment(refractRole, transmissions, settings);
  bool gathers = startGathers;

  // Bounded by the most links a chain can take before it has to describe a surface.
  for (int link = 0; link <= PT_PSR_MAX_CHAIN_DEPTH + PT_MAX_TRANSMISSION_DEPTH; link++)
  {
    float lightT = startLight;
    vec3 lightCenter = startLightCenter;
    if (link > 0)
    {
      lightT = gathers
        ? nearestSphereLight(segmentOrigin, direction, hitPayload.hit != 0u ? hitPayload.hitT : PT_RAY_TMAX,
          settings, lightCenter)
        : -1.0;
    }
    bool lightFirst = lightT >= 0.0;

    if (hitPayload.hit == 0u && !lightFirst)
    {
      // The sky through the chain: a direction at infinity, mirrored back across last frame's
      // planes the way the probe's own motion vector does it. A bent chain looks along the
      // straightened camera ray instead.
      vec3 previousDirection = direction;
      if (bent)
      {
        previousDirection = cameraDirection;
        for (int i = 0; i < mirrorCount; i++)
          previousDirection = mirrorDirection(previousDirection, mirrorNormals[i]);
      }
      for (int i = mirrorCount - 1; i >= 0; i--)
        previousDirection = mirrorDirection(previousDirection, previousMirrorNormals[i]);

      guides.albedo = vec4(0.0);
      guides.normal = vec4(0.0, 0.0, 0.0, 1.0);
      guides.throughput = vec4(throughput, 0.0);
      guides.depth = PT_SKY_DEPTH;
      guides.motion = specularMotionFromPrevClip(
        u_Frame.prevProj * (u_Frame.prevView * vec4(previousDirection, 0.0)), currentNDC);
      return;
    }

    // Based at the unoffset segment start for the same reason the probe's motion vector is:
    // the ray origin offset runs along the normal and would carry the point off the camera ray.
    // Only the offset's component along the ray is added back to hitT.
    float segmentLength = (lightFirst ? lightT : hitPayload.hitT) + dot(segmentOrigin - segmentBase, direction);
    vec3 X = segmentBase + direction * segmentLength;
    chainDistance += segmentLength;

    // What the estimator's own absorption takes off the same segment.
    throughput *= exp(-mediumAbsorption(media) * segmentLength);

    // What the chain ends on is described from its normal and its motion; a light's is the sphere's.
    vec3 endNormal;
    vec4 hitDelta[3] = WORLD_TO_PREV_WORLD_IDENTITY;
    PathSurface surface;
    bool dielectric = false;

    // The next link, a transmission or a mirror, is traced from one place below.
    bool follow = false;
    float linkTMin = 0.0;

    if (lightFirst)
    {
      endNormal = normalize(X - lightCenter);
    }
    else
    {
      RayHitGeometry hit = resolveHitGeometry(hitPayload.instanceIndex, hitPayload.primitiveIndex,
        hitPayload.objectToWorld, hitPayload.barycentrics, direction);
      surface = resolveHitMaterial(hit, hitPayload.barycentrics);
      hitDelta = u_Instances[hitPayload.instanceIndex].worldToPrevWorld;
      endNormal = surface.bsdf.N;

      dielectric = !surface.emissiveTexel && (hit.flags & RT_INSTANCE_DIELECTRIC) != 0u
        && hit.materialIndex < uint(u_Materials.length());

      if (dielectric && solid == PT_SOLID_REFRACT)
      {
        DielectricInterface face = resolveDielectricInterface(media, hit.materialIndex, hit.flags,
          hitPayload.frontFacing != 0u);
        MediumStack nextMedia = media;
        DielectricScatter scatter;
        if (scatterDielectric(hit, surface.bsdf.N, direction, face, PT_DIELECTRIC_TRANSMIT, 0.0,
          hit.materialIndex, nextMedia, scatter))
        {
          transmissions++;
          throughput *= scatter.weight;
          bent = bent || (scatter.crossedSolid && face.real);
          media = nextMedia;

          segmentBase = X;
          segmentOrigin = scatter.origin;
          direction = scatter.direction;

          solid = solidTreatment(refractRole, transmissions, settings);
          if (solid == PT_SOLID_STRAIGHT && media.count > 0)
            media = emptyMediumStack();

          follow = true;
        }
      }

      bool isMirror = !dielectric && !surface.emissiveTexel
        && isPureDeltaMirror(surface.bsdf);
      vec3 reflected = reflect(direction, surface.bsdf.N);

      if (!follow && isMirror && mirrorCount < maxMirrors && dot(reflected, hit.normal) > 0.0)
      {
        throughput *= fresnelSchlick(pathNdotV(surface.bsdf.N, direction), pathF0(surface.bsdf));

        mirrorNormals[mirrorCount] = surface.bsdf.N;
        mirrorPoints[mirrorCount] = X;
        previousMirrorPoints[mirrorCount] = applyWorldToPrevWorldPoint(hitDelta, X);
        previousMirrorNormals[mirrorCount] = applyWorldToPrevWorldDirection(hitDelta, surface.bsdf.N);
        mirrorCount++;

        segmentBase = X;
        segmentOrigin = offsetRayOrigin(hit.position, hit.normal);
        direction = reflected;

        follow = true;
        linkTMin = PT_RAY_TMIN;
        gathers = true;
      }
    }

    if (follow)
    {
      float straightGlassT;
      throughput *= traceSegment(segmentOrigin, direction, linkTMin, solid, straightGlassT);
      hitPayload = payload;
      continue;
    }

    // The last mirror of the chain images the point first, the primary vertex last.
    vec3 virtualNormal = endNormal;
    for (int i = mirrorCount - 1; i >= 0; i--)
      virtualNormal = mirrorDirection(virtualNormal, mirrorNormals[i]);

    // The straightened point of a bent chain, folded forward through this frame's mirrors into the
    // space the chain ends in, where it moves with the instance it landed on.
    vec3 endPoint = X;
    if (bent)
    {
      endPoint = u_Frame.cameraPosition + cameraDirection * chainDistance;
      for (int i = 0; i < mirrorCount; i++)
        endPoint = mirrorPoint(endPoint, mirrorPoints[i], mirrorNormals[i]);
    }

    vec3 previousVirtual = applyWorldToPrevWorldPoint(hitDelta, endPoint);
    for (int i = mirrorCount - 1; i >= 0; i--)
      previousVirtual = mirrorPoint(previousVirtual, previousMirrorPoints[i], previousMirrorNormals[i]);

    if (lightFirst)
    {
      guides.albedo = vec4(0.0);
      guides.normal = vec4(virtualNormal, 1.0);
      guides.throughput = vec4(throughput, 0.0);
    }
    else if (dielectric)
    {
      // Total internal reflection or a Solid the chain may not refract at: the dielectric is the
      // surface, and a smooth one with no diffuse response.
      guides.albedo = vec4(0.0);
      guides.normal = vec4(virtualNormal, 0.0);
      guides.throughput = vec4(throughput, 1.0);
    }
    else
    {
      bool hasPbrResponse = !surface.emissiveTexel;
      guides.albedo = vec4(surface.bsdf.albedo, surface.bsdf.metallic);
      guides.normal = vec4(virtualNormal, hasPbrResponse ? surface.bsdf.roughness : 1.0);
      guides.throughput = vec4(throughput, hasPbrResponse ? 1.0 : 0.0);
    }

    // Reversed-Z is near / viewZ, and viewZ grows linearly along the camera ray, so the virtual
    // point's depth is depth times distance over its distance - no reprojection, and exact to
    // the G-buffer's own value at a chain length of zero.
    guides.depth = depthScale / chainDistance;
    guides.motion = specularMotionFromPrevClip(
      u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtual, 1.0)), currentNDC);
    return;
  }
}

// The ray reconstruction specular guides from the probe ray's hit, glass it crosses straight already
// passed, so they describe the surface the mirror direction really shows - or the sphere light it runs
// into first, lightDistance along (-1 for none), as a static point. P is the G-buffer vertex the probe
// left from, previousP and previousN its plane as of the previous frame.
void probeSpecularGuides(RayTracingPayload hitPayload, float lightDistance, vec3 P, vec3 probeOrigin,
  vec3 probeDirection, vec3 previousP, vec3 previousN, vec2 currentNDC, out float hitDistance, out vec2 motion)
{
  bool lightFirst = lightDistance >= 0.0;
  bool hit = lightFirst || hitPayload.hit != 0u;
  float hitT = lightFirst ? lightDistance : hitPayload.hitT;

  // A reflection that leaves the scene has its virtual image at infinity, which is what the largest
  // distance the R16F guide can carry says. A real hit is clamped to the same ceiling so a far wall in a
  // large scene cannot overflow fp16 into infinity; the motion below takes hitT unclamped.
  hitDistance = hit ? min(hitT, PT_SPECULAR_MISS_DISTANCE) : PT_SPECULAR_MISS_DISTANCE;

  vec4 previousClip;
  if (hit)
  {
    // Based at P, not at the probe origin: that offset runs along N, and mirroring would carry it off
    // the camera ray - a constant bias even on a frame where nothing moves. hitT runs from the probe
    // origin, so the offset's component along the ray is added.
    vec3 X = P + probeDirection * (hitT + dot(probeOrigin - P, probeDirection));
    vec3 previousX = X;
    if (!lightFirst)
      previousX = applyWorldToPrevWorldPoint(u_Instances[hitPayload.instanceIndex].worldToPrevWorld, X);
    vec3 previousVirtual = mirrorPoint(previousX, previousP, previousN);
    previousClip = u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtual, 1.0));
  }
  else
  {
    // The environment sits at infinity and does not move, so only the reflected direction follows the
    // reflector.
    vec3 previousVirtualDirection = mirrorDirection(probeDirection, previousN);
    previousClip = u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtualDirection, 0.0));
  }

  motion = specularMotionFromPrevClip(previousClip, currentNDC);
}

// One replacePrimarySurface call as main gathers it.
struct ChainWalk
{
  vec3 chainStart;
  vec3 rayOrigin;
  vec3 direction;
  RayTracingPayload hitPayload;
  float startTMin;
  float startDistance;
  float depthScale;
  vec3 cameraDirection;
  vec3 throughput;
  int mirrorCount;
  int maxMirrors;
  vec3 firstMirrorNormal;
  vec3 firstPreviousMirrorPoint;
  vec3 firstPreviousMirrorNormal;
  // Walked by the glass reflection's settings rather than the pixel's.
  bool reflection;
  bool refractRole;
  int transmissions;
  // Describes the layer's first vertex rather than the primary one.
  bool layer;
  // hitPayload is the specular hit distance probe's, which the guides are taken from once its straight
  // glass is passed; guidesOnly stops there, with no chain to walk. A probe leaves the G-buffer vertex,
  // so its first segment is one a delta lobe gathers analytic lights on.
  bool probe;
  bool guidesOnly;
};

// One tracePath call as main gathers it. A path from a vertex starts at the pixel's G-buffer vertex.
struct PathJob
{
  bool fromRay;
  // The ray of a path from a ray; the vertex P and view vector V of one from a vertex.
  vec3 origin;
  vec3 direction;
  vec3 throughput;
  int firstVertex;
  int transmissionEvents;
  MediumStack media;
  // Traced by the glass reflection's settings rather than the pixel's.
  bool reflection;
  // What it gathers is the layer's radiance. From a vertex, it is traced by the layer's settings.
  bool layer;
};

// Every pixel needs at most two of each - a G-buffer path and its mirror, or a glass pixel's base and
// reflection - and runs them from one loop.
const int PT_PIXEL_JOBS = 2;

void main()
{
  ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
  if (pixel.x >= u_Frame.screenWidth || pixel.y >= u_Frame.screenHeight)
    return;

  vec2 uv = (vec2(pixel) + 0.5) / vec2(u_Frame.screenWidth, u_Frame.screenHeight);
  // The G-buffer is the size of the launch, so a filtered read at the pixel centre is this texel.
  float depth = texelFetch(u_Depth, pixel, 0).r;

  vec3 rayOrigin;
  vec3 rayDirection;
  primaryRay(pixel, rayOrigin, rayDirection);

  uint rngState = initRandomSeed(uvec2(gl_LaunchIDEXT.xy), uint(u_Frame.frameIndex));

  vec3 radiance = vec3(0.0);
  PathDebug pathDebug = PathDebug(0.0, -1.0, vec3(0.0), vec3(0.0), vec3(0.0));
  // The camera's own chain always refracts at a Solid: what the pixel shows through glass is the
  // image itself, so the knobs govern the rays past the first vertex that is not a pure delta.
  PathSettings pathSettings = PathSettings(pc.maxBounces, pc.fireflyClamp,
    pc.debugMode == PT_DEBUG_NONFINITE, pc.maxTransmissionDepth,
    pc.glassOverflow == PT_GLASS_OVERFLOW_STRAIGHT, true, pc.secondaryGlass == PT_GLASS_REFRACT,
    pc.glassEnabled != 0, pc.mirrorSun != 0, pc.sphereLightBegin, pc.sphereLightEnd);
  // The path reflected off a glass first vertex has a bounce budget and a Solid handling of its own.
  PathSettings reflectionSettings = pathSettings;
  reflectionSettings.maxBounces = pc.glassReflectionBounces;
  reflectionSettings.chainRefract = pc.glassReflectionGlass == PT_GLASS_REFRACT;
  // So has the mirror path of a G-buffer layer vertex, counted the same way: the vertex is its bounce
  // zero, so the reflected surface is bounce one.
  PathSettings layerSettings = pathSettings;
  layerSettings.maxBounces = pc.layerReflectionBounces + 1;

  float primaryDistance = PT_SKY_DISTANCE;
  // What ray reconstruction wants in kBufferTypeSpecularHitDistance, per section 3.4.9 of
  // NVIDIA's DLSS-RR Integration Guide: the WORLD SPACE distance between a specular ray's
  // origin - which must lie on the primary surface - and its hit point. It synthesizes the
  // specular motion vectors from this plus the camera matrices, so anything else fed here
  // makes reflections boil rather than merely look approximate.
  //
  // Measured by a dedicated probe ray along the mirror direction, NOT by whichever bounce the
  // lobe coin happened to pick. Gating it on the coin made the guide stochastic: on a
  // dielectric the specular lobe is chosen about a quarter of the time, so three frames in
  // four the guide read zero - "the virtual reflection sits on the surface" - and the fourth
  // read a real distance. Ray reconstruction reprojected the reflection one way and then the
  // other, frame after frame, which is exactly the flicker that showed up on glass. The probe
  // costs one coherent ray per shaded pixel and has no variance at all.
  //
  // Zero stays the answer where there is no surface to reflect off: the sky, an unlit texel
  // and an emissive one, none of which reach the probe below - and where the lobes are too wide
  // for the probe to be worth its ray, which places the reflection on the surface.
  float specularHitDistance = 0.0;

  // Every virtual point this pixel can be given lies on the camera ray through it, so its current
  // unjittered projection is the pixel centre plus the jitter whatever its distance - the same
  // current NDC backgroundVelocity builds.
  vec2 pixelNDC = uv * 2.0 - 1.0;
  vec2 currentNDC = pixelNDC + vec2(u_Frame.jitterX, u_Frame.jitterY);
  vec2 specularMotion = vec2(0.0);

  // The first vertex as ray reconstruction is told about it. Defaults are the sky's; a surface
  // copies the G-buffer below, and Primary Surface Replacement overwrites all of it on a delta
  // chain.
  FirstVertexGuides primary = FirstVertexGuides(vec4(0.0), vec4(0.0, 0.0, 0.0, 1.0),
    vec4(1.0, 1.0, 1.0, 0.0), depth, texelFetch(u_MainVelocity, pixel, 0).rg);

  // The reflection layer. A layer pixel is a G-buffer vertex with a delta layer lobe
  // (reflectionLayerLobe) or a glass first vertex: that lobe is traced as a path of its own into
  // layerRadiance, weighted by its expected weight F - the delta branch without the lobe coin - and
  // the second RR instance is told about the reflected surface. Everywhere else the layer first
  // vertex copies the primary one.
  bool layerPixel = false;
  vec3 layerF = vec3(0.0);
  vec3 layerRadiance = vec3(0.0);
  FirstVertexGuides layer = FirstVertexGuides(vec4(0.0), vec4(0.0, 0.0, 0.0, 1.0),
    vec4(1.0, 1.0, 1.0, 0.0), PT_SKY_DEPTH, vec2(0.0));

  // The walks and paths the pixel needs are gathered first and run from one loop each below. Pixels
  // that call the same traces in the same order are what a ray tracing pipeline schedules well:
  // the same work split across separate call sites per case measured over a third slower.
  ChainWalk walks[PT_PIXEL_JOBS];
  int walkCount = 0;
  PathJob paths[PT_PIXEL_JOBS];
  int pathCount = 0;
  // The G-buffer vertex of the paths that start from one.
  PathBsdf vertexBsdf = uncoatedBsdf(vec3(0.0, 1.0, 0.0), vec3(0.0), 0.0, 1.0);
  // Primary Surface Replacement took over the primary guides.
  bool primaryReplaced = false;

  // The same reconstruction deferred_lighting.frag performs, out of the same reversed-Z
  // depth and the same inverse matrices.
  vec3 worldPos = u_Frame.cameraPosition;
  if (depth > PT_SKY_DEPTH)
  {
    vec3 viewPos = reconstructViewPos(uv, depth);
    worldPos = (u_Frame.invView * vec4(viewPos, 1.0)).xyz;
    primaryDistance = length(worldPos - u_Frame.cameraPosition);
  }

  // Glass in front of the G-buffer surface, or in front of the sky. The G-buffer never holds a
  // transparent surface, so the jittered camera ray is traced against the glass alone, no further
  // than the surface the G-buffer does hold. The front-most glass surface gives the pixel its
  // reflection layer whatever its class. What the pixel shows through it turns on whether a Solid lies
  // before the G-buffer surface: without one nothing on the camera ray bends, so the base radiance and
  // guides stay the G-buffer surface's, dimmed by one query over every straight interface in front of
  // it however many there are; with one the pixel is the refractive chain from the first Solid on. A
  // first vertex is glass or an opaque smooth dielectric, never both, so the two share the layer images
  // and the second RR instance. With the PT Glass switch off the TLAS holds no glass and none is traced.
  float gbufferRange = depth > PT_SKY_DEPTH ? primaryDistance : PT_RAY_TMAX;

  payload.hit = 0u;
  if (pathSettings.glass)
  {
    traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_GLASS,
      uint(PT_PATH_HIT_GROUP), 0u, uint(PT_PRIMARY_MISS_INDEX),
      rayOrigin, PT_RAY_TMIN, rayDirection, gbufferRange,
      0);
  }
  bool glassPixel = payload.hit != 0u
    && u_Instances[payload.instanceIndex].materialIndex < uint(u_Materials.length());
  RayTracingPayload frontPayload = payload;

  RayHitGeometry frontHit;
  PathSurface frontSurface;
  bool frontEmissive = false;
  bool frontSolid = false;
  bool solidInFront = false;
  RayTracingPayload solidPayload = frontPayload;
  vec3 frontTransmittance = vec3(1.0);
  if (glassPixel)
  {
    frontHit = resolveHitGeometry(frontPayload.instanceIndex, frontPayload.primitiveIndex,
      frontPayload.objectToWorld, frontPayload.barycentrics, rayDirection);
    frontSurface = resolveHitMaterial(frontHit, frontPayload.barycentrics);
    frontEmissive = frontSurface.emissiveTexel;
    frontSolid = (frontHit.flags & RT_INSTANCE_SOLID_DIELECTRIC) != 0u;
    solidInFront = !frontEmissive && frontSolid;

    if (!frontEmissive && !frontSolid)
    {
      payload.hit = 0u;
      traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_GLASS_REFRACTIVE,
        uint(PT_PATH_HIT_GROUP), 0u, uint(PT_PRIMARY_MISS_INDEX),
        rayOrigin, PT_RAY_TMIN, rayDirection, gbufferRange,
        0);
      solidInFront = payload.hit != 0u;
      solidPayload = payload;

      bool crossedSolid;
      frontTransmittance = traceStraightTransmittance(rayOrigin, rayDirection, PT_RAY_TMIN,
        solidInFront ? solidPayload.hitT : gbufferRange, RT_MASK_GLASS_STRAIGHT, crossedSolid);
    }
  }

  // Whether the base radiance and guides are the G-buffer surface's, through straight glass or none.
  bool gbufferBase = !frontEmissive && !solidInFront;

  if (depth <= PT_SKY_DEPTH)
  {
    // The sky is not a surface: there is no vertex to shade and no path to start.
    if (gbufferBase)
      radiance = texture(u_Skybox, rayDirection).rgb * frontTransmittance;
    specularMotion = backgroundVelocity(pixelNDC);
  }
  else
  {
    vec4 gb0 = texelFetch(u_GBuffer0, pixel, 0);
    vec4 gb1 = texelFetch(u_GBuffer1, pixel, 0);
    vec3 texelNormal = octDecode(gb1.rg * 2.0 - 1.0);

    int shadingModel = decodeShadingModel(gb1.a);
    // Full roughness unless the PBR branch says otherwise: the widest filter for a texel with
    // no lobe, exactly what the guides wrote for it before.
    primary.normal = vec4(texelNormal, 1.0);

    if (shadingModel == SHADING_UNLIT)
    {
      // Unlit is the raster's own escape hatch - the albedo IS the final colour - so there
      // is nothing to integrate and the path stops before it starts.
      if (gbufferBase)
        radiance = gb0.rgb * frontTransmittance;
      // Nothing is reflected, so the image moves with the surface itself.
      specularMotion = texelFetch(u_MainVelocity, pixel, 0).rg;
    }
    else if (shadingModel == SHADING_EMISSIVE)
    {
      // GBuffer0 holds encoded emission instead of albedo and metallic for this texel, and
      // an emissive texel has given up its PBR response, so it emits and nothing else.
      if (gbufferBase)
        radiance = decodeEmissive(gb0) * frontTransmittance;
      specularMotion = texelFetch(u_MainVelocity, pixel, 0).rg;
    }
    else
    {
      // On a coat texel GBuffer1 describes the coat, and the surface under it comes out of GBuffer2;
      // the G-buffer pass writes that shading model only for a weight GBuffer2 keeps above zero.
      vec3 coatN = texelNormal;
      bool coated = shadingModel == SHADING_CLEAR_COAT;
      PathBsdf bsdf = uncoatedBsdf(coatN, gb0.rgb, gb0.a, gb1.b);
      if (coated)
      {
        vec4 gb2 = texelFetch(u_GBuffer2, pixel, 0);
        bsdf.N = decodeClearCoatBaseNormal(gb2, coatN);
        bsdf.roughness = gb2.g;
        bsdf.clearCoat = gb2.r;
        bsdf.coatRoughness = gb1.b;
      }
      vertexBsdf = bsdf;

      // A glass pixel's layer is its glass.
      int layerLobe = glassPixel ? PT_LAYER_LOBE_NONE : reflectionLayerLobe(bsdf);
      // The normal the mirror direction is taken about: the surface's where its specular lobe is the
      // layer, the coat's otherwise (the shading normal without a coat).
      vec3 mirrorN = layerLobe == PT_LAYER_LOBE_SURFACE ? bsdf.N : coatN;

      vec3 P = worldPos;
      // The view vector deferred_lighting.frag builds, not -rayDirection: the two differ by
      // the pixel centre and the sub-pixel jitter, and matching the raster is the whole
      // reason this path starts from its G-buffer.
      vec3 V = normalize(u_Frame.cameraPosition - P);

      // The base instance is told about the surface, under a coat as seen through what the coat
      // lets back out.
      primary.albedo = gb0;
      primary.normal = coated ? vec4(bsdf.N, bsdf.roughness) : vec4(texelNormal, gb1.b);
      primary.throughput = vec4(vec3(1.0 - clearCoatFresnel(bsdf.clearCoat, pathNdotV(coatN, V))), 1.0);

      // Past a Solid or an emitting glass the pixel describes something else entirely, so the
      // G-buffer surface's own guides and paths are worth no ray there.
      if (gbufferBase)
      {
        // The specular hit distance probe. Traced before the path starts and independently of
        // it, so the guide describes the surface rather than the sample: same origin the bounce
        // rays leave from, mirror direction, and nothing is shaded at the far end - the closest
        // hit shader writes the parametric distance and the path loop below never sees this
        // payload. Opaque flag deliberately absent so alpha-tested geometry cuts out here too,
        // otherwise a foliage card would report a reflection that is not there.
        //
        // A metallic mirror and a layer vertex always trace it: their walks start from it. Any other
        // vertex only traces it while its narrowest lobe is within the guide threshold; past it the
        // reflection is reported on the surface itself, moving with it.
        vec3 probeOrigin = offsetRayOrigin(P, coatN);
        vec3 probeDirection = reflect(-V, mirrorN);
        bool pureMirror = isPureDeltaMirror(bsdf);
        float lobeRoughness = coated ? min(bsdf.roughness, bsdf.coatRoughness) : bsdf.roughness;
        bool probed = pureMirror || layerLobe != PT_LAYER_LOBE_NONE
          || lobeRoughness <= pc.specularGuideMaxRoughness;

        if (!probed)
        {
          specularMotion = texelFetch(u_MainVelocity, pixel, 0).rg;
        }
        else
        {
          payload.hit = 0u;
          traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_PATH,
            uint(PT_PATH_HIT_GROUP), 0u, uint(PT_PRIMARY_MISS_INDEX),
            probeOrigin, PT_RAY_TMIN, probeDirection, PT_RAY_TMAX,
            0);

          // Copied before anything else traces: the payload is shared, and the lookup below
          // overwrites it. The glass it crosses straight is passed, and its guides taken, in the walk
          // loop - every pixel's probe goes through that one call site.
          RayTracingPayload probePayload = payload;

          // The G-buffer does not say which instance P belongs to, so a moving reflector is found by
          // tracing the camera ray to it - over the moving instances alone, and only across the span
          // the reconstructed depth allows. No hit there, or no instance moving at all, is a static
          // reflector. Opaque instances only: the G-buffer holds nothing else.
          vec3 cameraDirection = (P - u_Frame.cameraPosition) / primaryDistance;
          vec4 reflectorDelta[3] = WORLD_TO_PREV_WORLD_IDENTITY;
          if (pc.reflectorLookup != 0)
          {
            float lookupTolerance = primaryDistance * PT_REFLECTOR_LOOKUP_RELATIVE_TOLERANCE
              + PT_REFLECTOR_LOOKUP_ABSOLUTE_TOLERANCE;

            payload.hit = 0u;
            traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_MOVING,
              uint(PT_PATH_HIT_GROUP), 0u, uint(PT_PRIMARY_MISS_INDEX),
              u_Frame.cameraPosition, max(primaryDistance - lookupTolerance, PT_RAY_TMIN), cameraDirection,
              primaryDistance + lookupTolerance,
              0);

            if (payload.hit != 0u)
              reflectorDelta = u_Instances[payload.instanceIndex].worldToPrevWorld;
          }

          // mirrorN is the normal the probe direction was reflected about.
          vec3 previousP = applyWorldToPrevWorldPoint(reflectorDelta, P);
          vec3 previousN = applyWorldToPrevWorldDirection(reflectorDelta, mirrorN);

          // f0, NdotV and the coat's transmission exactly as the bounce loop builds them, so a layer's F
          // is its delta branch's weight.
          PathVertexTerms terms = preparePathVertex(bsdf, V, PT_FIRST_VERTEX_MIRROR);

          if (pureMirror)
          {
            // The delta branch's expected weight, Fresnel. Its division by the lobe probability
            // is the estimator's business, not a property of the surface RR is told about. A pure
            // delta keeps the camera's chain going, so glass past it is met by that role.
            walks[walkCount++] = ChainWalk(P, probeOrigin, probeDirection, probePayload, PT_RAY_TMIN,
              primaryDistance, depth * primaryDistance, cameraDirection, fresnelSchlick(terms.NdotV, terms.f0), 1,
              pc.maxBounces, mirrorN, previousP, previousN, false, pathSettings.chainRefract, 0, false, true,
              false);
            primaryReplaced = true;
          }
          else if (layerLobe != PT_LAYER_LOBE_NONE)
          {
            // The same machinery pointed at the layer first vertex instead of the primary one: a delta
            // coat, or a smooth dielectric's own specular lobe - under a glossy coat, seen through both
            // crossings of the coat. F itself rides the RR colour alpha and is applied in
            // rr_layer_composite.comp, so the chain starts at a throughput of one. The vertex has more
            // lobes than the mirror, so what its mirror path meets is past the camera's chain, and the
            // chain sees as far as that path's own bounce budget.
            layerPixel = true;
            layerF = layerLobe == PT_LAYER_LOBE_COAT
              ? vec3(1.0 - terms.coatViewTransmission)
              : fresnelSchlick(terms.NdotV, terms.f0) * clearCoatTransmission(bsdf, terms, probeDirection);
            walks[walkCount++] = ChainWalk(P, probeOrigin, probeDirection, probePayload, PT_RAY_TMIN,
              primaryDistance, depth * primaryDistance, cameraDirection, vec3(1.0), 1, layerSettings.maxBounces,
              mirrorN, previousP, previousN, false, pathSettings.secondaryRefract, 0, true, true, false);
          }
          else
          {
            // No chain to walk: the probe only passes its straight glass and gives the guides, from the
            // role a bounce off this vertex has.
            walks[walkCount++] = ChainWalk(P, probeOrigin, probeDirection, probePayload, PT_RAY_TMIN,
              primaryDistance, depth * primaryDistance, cameraDirection, vec3(1.0), 1, pc.maxBounces, mirrorN,
              previousP, previousN, false, pathSettings.secondaryRefract, 0, false, true, true);
          }
        }

        // A layer pixel runs two paths from the same first vertex - the base path (NEE and every
        // other lobe) and the mirror path - so both are sampled every frame instead of one by the
        // coin. The expected value is the coin's: each lobe keeps its weight and only loses the 1 / p
        // it paid for being picked. Straight glass in front dims both from the start. A metallic
        // mirror under a glossy coat stays with the coin, see reflectionLayerLobe.
        int passes = layerPixel ? 2 : 1;
        for (int pass = 0; pass < passes; pass++)
        {
          int firstVertex = !layerPixel ? PT_FIRST_VERTEX_COIN
            : (pass == 0 ? PT_FIRST_VERTEX_BASE : PT_FIRST_VERTEX_MIRROR);
          paths[pathCount++] = PathJob(false, P, V, frontTransmittance, firstVertex, 0,
            emptyMediumStack(), false, pass == 1);
        }
      }
    }
  }

  if (glassPixel)
  {
    vec4 frontDelta[3] = u_Instances[frontPayload.instanceIndex].worldToPrevWorld;
    vec3 previousFrontPoint = applyWorldToPrevWorldPoint(frontDelta, frontHit.position);
    float depthScale = projectDepth(frontHit.position) * frontPayload.hitT;

    if (frontEmissive)
    {
      // Emission wins over transmission on a dielectric as it does everywhere: a pure emitter,
      // described the way an emissive G-buffer texel is.
      radiance = frontSurface.emissive;
      primary = FirstVertexGuides(vec4(0.0), vec4(frontSurface.bsdf.N, 1.0),
        vec4(1.0, 1.0, 1.0, 0.0), depthScale / frontPayload.hitT,
        specularMotionFromPrevClip(
          u_Frame.prevProj * (u_Frame.prevView * vec4(previousFrontPoint, 1.0)), currentNDC));
      specularMotion = primary.motion;
      specularHitDistance = 0.0;
    }
    else
    {
      MediumStack air = emptyMediumStack();

      // Past a Solid the pixel shows the refractive chain from it, walked from the camera by the
      // estimator's rules and dimmed by the straight glass in front for ray reconstruction, and
      // transmitted into with the expected weight 1 - F for the radiance - the Solid's reflection is
      // the layer where it is the front-most surface, and energy this pixel leaves out behind
      // straight glass.
      if (solidInFront)
      {
        RayHitGeometry solidHit = frontHit;
        PathSurface solidSurface = frontSurface;
        if (!frontSolid)
        {
          solidHit = resolveHitGeometry(solidPayload.instanceIndex, solidPayload.primitiveIndex,
            solidPayload.objectToWorld, solidPayload.barycentrics, rayDirection);
          solidSurface = resolveHitMaterial(solidHit, solidPayload.barycentrics);
        }

        walks[walkCount++] = ChainWalk(rayOrigin, rayOrigin, rayDirection, solidPayload, PT_RAY_TMIN,
          0.0, depthScale, rayDirection, frontTransmittance, 0, pc.maxBounces, vec3(0.0, 1.0, 0.0),
          vec3(0.0), vec3(0.0, 1.0, 0.0), false, true, 0, false, false, false);
        primaryReplaced = true;

        if (solidSurface.emissiveTexel)
        {
          radiance = solidSurface.emissive * frontTransmittance;
        }
        else
        {
          DielectricInterface solidFace = resolveDielectricInterface(air, solidHit.materialIndex,
            solidHit.flags, solidPayload.frontFacing != 0u);
          MediumStack media = air;
          DielectricScatter transmission;
          if (scatterDielectric(solidHit, solidSurface.bsdf.N, rayDirection, solidFace,
            PT_DIELECTRIC_TRANSMIT, 0.0, solidHit.materialIndex, media, transmission))
          {
            paths[pathCount++] = PathJob(true, transmission.origin, transmission.direction,
              frontTransmittance * transmission.weight, PT_FIRST_VERTEX_COIN, 1, media, false, false);
          }
        }
      }

      // The reflection layer, off the front-most glass whatever lies behind it, with that surface's
      // own reflectance - a Sheet's slab, one interface otherwise. Its F rides the layer alpha. The
      // reflection is one of the path's refractive events only where the surface is a Solid.
      int reflectionEvents = frontSolid ? 1 : 0;
      DielectricInterface frontFace = resolveDielectricInterface(air, frontHit.materialIndex,
        frontHit.flags, frontPayload.frontFacing != 0u);
      // About the normal the rest of the pixel weighs the same interface with, so the layer and what the
      // base lets through add up to one: a Solid in front transmits about its shading normal above, and
      // straight glass is weighed by the transmittance query, whose any-hit reads no normal map.
      vec3 frontNormal = frontSolid ? frontSurface.bsdf.N : frontHit.shadingNormal;
      MediumStack reflectionMedia = air;
      DielectricScatter reflection;
      bool reflects = scatterDielectric(frontHit, frontNormal, rayDirection, frontFace,
        PT_DIELECTRIC_REFLECT, 0.0, frontHit.materialIndex, reflectionMedia, reflection);
      layerF = reflection.weight;
      layerPixel = true;

      // The layer instance's first vertex is the front face as a mirror, replaced from the reflected
      // segment's hit. The mirror is the one scatterDielectric reflects about, from the origin it
      // reflects from, so the walk and the reflection path share that segment.
      vec3 mirrorNormal = dot(frontNormal, -rayDirection) > 0.0
        ? frontNormal : frontHit.normal;
      vec3 reflectedDirection = reflect(rayDirection, mirrorNormal);
      vec3 reflectedOrigin = offsetDielectricOrigin(frontHit.position, frontHit.normal);

      float reflectedGlassT;
      vec3 reflectedTransmittance = traceSegment(reflectedOrigin, reflectedDirection, 0.0,
        solidTreatment(reflectionSettings.chainRefract, reflectionEvents, reflectionSettings), reflectedGlassT);

      walks[walkCount++] = ChainWalk(frontHit.position, reflectedOrigin, reflectedDirection, payload,
        0.0, frontPayload.hitT, depthScale, rayDirection, reflectedTransmittance, 1,
        pc.glassReflectionBounces + 1, mirrorNormal, previousFrontPoint,
        applyWorldToPrevWorldDirection(frontDelta, mirrorNormal), true,
        reflectionSettings.chainRefract, reflectionEvents, true, false, false);

      if (reflects)
      {
        paths[pathCount++] = PathJob(true, reflection.origin, reflection.direction,
          reflection.weight, PT_FIRST_VERTEX_COIN, reflectionEvents, reflectionMedia, true, true);
      }
    }
  }

  // The gathered walks. Each first passes the glass its start segment crosses straight - a no-op for a
  // segment traceSegment already finished - and the probe's guides are taken past it, as far as the
  // sphere light the start segment of a probe runs into first.
  for (int w = 0; w < walkCount; w++)
  {
    ChainWalk walk = walks[w];
    PathSettings walkSettings = walk.reflection ? reflectionSettings : pathSettings;

    payload = walk.hitPayload;
    float straightGlassT;
    vec3 startTransmittance = passStraightGlass(walk.rayOrigin, walk.direction, walk.startTMin,
      solidTreatment(walk.refractRole, walk.transmissions, walkSettings), straightGlassT);
    RayTracingPayload startPayload = payload;

    vec3 startLightCenter = vec3(0.0);
    float startLight = -1.0;
    if (walk.probe)
    {
      startLight = nearestSphereLight(walk.rayOrigin, walk.direction,
        startPayload.hit != 0u ? startPayload.hitT : PT_RAY_TMAX, walkSettings, startLightCenter);
      probeSpecularGuides(startPayload, startLight, walk.chainStart, walk.rayOrigin, walk.direction,
        walk.firstPreviousMirrorPoint, walk.firstPreviousMirrorNormal, currentNDC, specularHitDistance,
        specularMotion);
    }
    if (walk.guidesOnly)
      continue;

    FirstVertexGuides guides = walk.layer ? layer : primary;
    replacePrimarySurface(walk.chainStart, walk.rayOrigin, walk.direction, startPayload, startLight,
      startLightCenter, walk.probe, walk.startDistance, walk.depthScale, walk.cameraDirection,
      walk.throughput * startTransmittance, walk.mirrorCount, walk.maxMirrors, walk.firstMirrorNormal,
      walk.firstPreviousMirrorPoint, walk.firstPreviousMirrorNormal, emptyMediumStack(), walkSettings,
      walk.refractRole, walk.transmissions, currentNDC, guides);
    if (walk.layer)
      layer = guides;
    else
      primary = guides;
  }

  if (primaryReplaced)
  {
    // On a replaced pixel the surface RR is told about is the one seen through the mirror or the
    // glass: the two motion tags agree, and ptDepth already sits there, so no reflection distance is
    // left beyond it.
    specularMotion = primary.motion;
    specularHitDistance = 0.0;
  }
  if (glassPixel && gbufferBase)
  {
    // Nothing on the camera ray bends, so ray reconstruction is told about the G-buffer surface
    // exactly as the walks described it, dimmed by what the straight glass lets through.
    primary.throughput.rgb *= frontTransmittance;
  }

  // The gathered paths. A layer path's radiance is moved into layerRadiance afterwards.
  for (int p = 0; p < pathCount; p++)
  {
    PathJob job = paths[p];
    vec3 passRadianceStart = radiance;

    // The G-buffer carries no geometric normal. The coat normal - the vertex normal under a coat, the
    // shading normal without one - stands in for it. A path from a ray reads no vertex.
    PathSettings jobSettings = job.reflection ? reflectionSettings : job.layer ? layerSettings : pathSettings;
    tracePath(job.fromRay, job.origin, job.direction, job.origin, vertexBsdf, vertexBsdf.coatN, job.direction,
      job.throughput, jobSettings, job.firstVertex, job.transmissionEvents, job.media, true, rngState,
      radiance, pathDebug);

    if (job.layer)
    {
      layerRadiance += radiance - passRadianceStart;
      radiance = passRadianceStart;
    }
  }

  // Last line of defence, and the reason it is worth its two instructions: the accumulation
  // image is read-modify-written, so one NaN reaching it is blended into every later sample
  // and that pixel stays poisoned for the rest of the run.
  if (any(isnan(radiance)) || any(isinf(radiance)))
    radiance = vec3(0.0);
  if (any(isnan(layerRadiance)) || any(isinf(layerRadiance)))
    layerRadiance = vec3(0.0);

  // Ahead of the debug returns below: the guide pass and ray reconstruction still run while a
  // diagnostic is selected, and they read these rather than the G-buffer.
  imageStore(outPrimaryAlbedo, pixel, primary.albedo);
  imageStore(outPrimaryNormal, pixel, primary.normal);
  imageStore(outPrimaryThroughput, pixel, primary.throughput);
  imageStore(outPTDepth, pixel, vec4(primary.depth));
  imageStore(outPTMotion, pixel, vec4(primary.motion, 0.0, 0.0));

  if (!layerPixel)
    layer = primary;

  // Unweighted reflection, F in alpha for RR's alpha upscaling and the composite. The path was
  // traced with F in its throughput so the firefly clamp and Russian roulette see exactly what
  // the estimator's delta branch sees; it is divided back out here.
  vec4 layerOut = layerPixel
    ? vec4(layerRadiance / max(layerF, vec3(1e-4)), layerF.g)
    : vec4(0.0);

  imageStore(outLayerRadiance, pixel, layerOut);
  imageStore(outLayerAlbedo, pixel, layer.albedo);
  imageStore(outLayerNormal, pixel, layer.normal);
  imageStore(outLayerThroughput, pixel, layer.throughput);
  imageStore(outLayerDepth, pixel, vec4(layer.depth));
  imageStore(outLayerMotion, pixel, vec4(layer.motion, 0.0, 0.0));

  // The diagnostics ride the noisy image rather than a target of their own: it is already
  // RGBA16F at render resolution and the tone map already samples it, so a debug view costs
  // no allocation. The accumulation store below is skipped entirely while one is selected -
  // blending a diagnostic into the running mean would be meaningless.
  //
  // Stored as a PLAIN base-10 logarithm with a floor, not as log(1 + x). The values worth
  // reading here straddle one: a correct contribution sits near it and a broken one sits
  // several orders above, so the scale has to resolve both directions. log(1 + x) compresses
  // everything below one into almost nothing and would render the entire useful lower half of
  // the range as a single shade. The floor at 1e-4 is what keeps the logarithm finite at zero
  // and fixes the bottom of the scale; PT_DEBUG_LOG_MIN and _MAX bound it on both sides.
  // Raw integers, deliberately NOT on the log ramp the block below uses: this view is read
  // back numerically out of the captured image, so the code has to survive the round trip
  // exactly. R is the PT_NF_* code, G the bounce it fired on, -1 where nothing fired.
  if (pc.debugMode == PT_DEBUG_NONFINITE)
  {
    imageStore(outNoisy, pixel,
      vec4(float(g_NonFiniteCode), float(g_NonFiniteBounce), 0.0, 0.0));
    return;
  }

  if (pc.debugMode != PT_DEBUG_OFF)
  {
    vec3 value = vec3(pathDebug.maxContribution);
    if (pc.debugMode == PT_DEBUG_NEE)
      value = pathDebug.nee;
    else if (pc.debugMode == PT_DEBUG_ENVIRONMENT)
      value = pathDebug.environment;
    else if (pc.debugMode == PT_DEBUG_DELTA_LIGHTS)
      value = pathDebug.deltaLights;

    float magnitude = max(value.r, max(value.g, value.b));
    float logMagnitude = log(max(magnitude, PT_DEBUG_LOG_FLOOR)) / log(10.0);
    imageStore(outNoisy, pixel, vec4(vec3(logMagnitude), pathDebug.maxBounce));
    return;
  }

  // The forward transparent layer goes over the sample itself. Drawn with the same jitter, it is denoised
  // and upscaled by ray reconstruction - which also takes the sample from before it - and converges in the
  // running mean with everything else.
  vec4 transparent = vec4(0.0);
  if (pc.transparentLayer != 0)
  {
    transparent = texelFetch(u_TransparentLayer, pixel, 0);
    if (any(isnan(transparent)) || any(isinf(transparent)))
      transparent = vec4(0.0);
    transparent = vec4(max(transparent.rgb, vec3(0.0)), clamp(transparent.a, 0.0, 1.0));
  }

  imageStore(outColorBeforeTransparency, pixel, vec4(radiance, primaryDistance));
  imageStore(outNoisy, pixel, vec4(radiance * (1.0 - transparent.a) + transparent.rgb, primaryDistance));
  imageStore(outHitDistance, pixel, vec4(specularHitDistance));
  imageStore(outSpecularMotion, pixel, vec4(specularMotion, 0.0, 0.0));

  if (pc.sampleIndex >= 0)
  {
    // The reference is base + layer, which is the coin estimator's expectation - see the path
    // split above.
    vec3 fullRadiance = (radiance + layerRadiance) * (1.0 - transparent.a) + transparent.rgb;
    vec4 accumulated = vec4(fullRadiance, 1.0);

    if (pc.sampleIndex > 0)
    {
      // Running mean, so the reference image converges without the CPU ever reading it
      // back: sample n is blended in at 1 / (n + 1). Index zero rewrites the image
      // outright, which IS the reset - the buffer never has to be cleared.
      vec4 previous = imageLoad(outAccumulation, pixel);
      float blend = 1.0 / float(pc.sampleIndex + 1);
      accumulated = mix(previous, vec4(fullRadiance, 1.0), blend);
    }

    imageStore(outAccumulation, pixel, accumulated);
  }
}
