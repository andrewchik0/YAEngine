#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

// The whole path tracer: one sample per pixel per frame, the bounce loop iterative and
// entirely in ray generation - see pt_path.glsl - so the hit and miss shaders stay the thin
// ones pathtrace.rchit/.rmiss already are and the pipeline needs a recursion depth of one.
//
// The first path vertex is NOT traced. It is read back out of the G-buffer, which means the
// tracer starts from exactly the surface the raster pipeline shaded, sub-pixel jitter
// included, and the two images are comparable pixel for pixel instead of only statistically.
// What ray reconstruction is told about that vertex is written separately (outPrimary*,
// outPTDepth, outPTMotion): a copy of the G-buffer, except on metallic delta mirrors, where
// Primary Surface Replacement describes the surface seen through the mirror instead.
//
// Always bindless: every bounce resolves its material through the texture table, so there is
// no non-bindless permutation to be.
#define RT_BINDLESS
#include "raytracing_common.glsl"
#include "utils.glsl"
#include "octahedron.glsl"
#include "pbr.glsl"
#include "random.glsl"
#include "light_eval.glsl"
#include "../Shared/PathTraceData.h"
#include "../Shared/EmissiveLightData.h"
#include "specular_motion.glsl"

// Set 1 bindings 3 and up are the pass's own: the G-buffer, the sky, the lights and the
// outputs. Bindings 0-2 are the scene, declared once in raytracing_common.glsl.
layout(set = 1, binding = 3) uniform sampler2D u_GBuffer0;
layout(set = 1, binding = 4) uniform sampler2D u_GBuffer1;
layout(set = 1, binding = 5) uniform sampler2D u_Depth;
// The same cubemap deferred lighting samples for its sky pixels, so the horizon behind a
// traced image and behind the rasterized one is one texture, not two.
layout(set = 1, binding = 6) uniform samplerCube u_Skybox;

layout(std430, set = 1, binding = 7) readonly buffer PathTraceLightSSBO
{
  LightBuffer u_Lights;
};

// Radiance in rgb, primary hit distance in alpha. Stage 5's ray reconstruction wants the
// distance next to the colour, and it costs nothing to write here.
layout(set = 1, binding = 8, rgba16f) uniform writeonly image2D outNoisy;
// Read-modify-write, unlike everything else the engine stores into: the running mean lives
// in the image itself rather than in a second buffer the CPU would have to ping-pong.
layout(set = 1, binding = 9, rgba32f) uniform image2D outAccumulation;
// The same primary hit distance the alpha above carries, in an image of its own because a
// Streamline tag names one resource and cannot point at a channel of another. Two bytes per
// pixel and one store, next to a value this shader has already computed.
layout(set = 1, binding = 10, r16f) uniform writeonly image2D outHitDistance;
// The alternative ray reconstruction specular guide to the hit distance above, in MainVelocity's
// convention - see specular_motion.glsl. Which of the two is tagged is the panel's choice.
layout(set = 1, binding = 11, rg16f) uniform writeonly image2D outSpecularMotion;
// Read where the virtual image sits on the surface itself: unlit and emissive texels.
layout(set = 1, binding = 12) uniform sampler2D u_MainVelocity;
// The first path vertex as ray reconstruction is told about it - see Render.h. A copy of the
// G-buffer everywhere except on metallic delta mirrors, which are replaced by what they show.
layout(set = 1, binding = 13, rgba8) uniform writeonly image2D outPrimaryAlbedo;
layout(set = 1, binding = 14, rgba16f) uniform writeonly image2D outPrimaryNormal;
layout(set = 1, binding = 15, rgba16f) uniform writeonly image2D outPrimaryThroughput;
layout(set = 1, binding = 16, r32f) uniform writeonly image2D outPTDepth;
layout(set = 1, binding = 17, rg16f) uniform writeonly image2D outPTMotion;
// PROTOTYPE (dielectric reflection layer spike): the mirror path of a smooth dielectric first
// vertex, denoised by a second RR instance, and that instance's first vertex, PSR-style on
// layer pixels and a copy of the primary one elsewhere.
layout(set = 1, binding = 18, rgba16f) uniform writeonly image2D outLayerRadiance;
layout(set = 1, binding = 19, rgba8) uniform writeonly image2D outLayerAlbedo;
layout(set = 1, binding = 20, rgba16f) uniform writeonly image2D outLayerNormal;
layout(set = 1, binding = 21, rgba16f) uniform writeonly image2D outLayerThroughput;
layout(set = 1, binding = 22, r32f) uniform writeonly image2D outLayerDepth;
layout(set = 1, binding = 23, rg16f) uniform writeonly image2D outLayerMotion;

// The emissive light table next event estimation samples emitting geometry from, see
// EmissiveLightData.h. Built with this frame slot's instance records.
layout(std430, set = 1, binding = 24) readonly buffer PathTraceEmissiveLightSSBO
{
  EmissiveLightTableHeader u_EmissiveHeader;
  EmissiveLightRecord u_EmissiveLights[];
};

layout(push_constant) uniform PathTracePushBlock
{
  PathTraceConstants pc;
};

layout(location = 0) rayPayloadEXT RayTracingPayload payload;
layout(location = 1) rayPayloadEXT ShadowRayPayload shadowPayload;

#include "pt_path.glsl"

// Reversed-Z: the sky is exactly zero and everything else is above it.
const float PT_SKY_DEPTH = 0.0;

// Primary Surface Replacement - see PT_PSR_MIN_METALLIC. The first vertex (P, N) is a metallic
// delta mirror whose probe ray came back as probePayload. The chain is followed to the first
// surface that is not one, and the first-vertex outputs are rewritten to describe it as a
// virtual surface on the camera ray: its material, its normal mirrored back through every mirror
// (which keeps the angle to the camera ray the real hit had), the chain's Fresnel as throughput,
// and the depth and motion of the virtual point. The radiance estimator is not touched.
void replacePrimarySurface(vec3 P, vec3 N, vec3 f0, float NdotV, float depth,
  float primaryDistance, vec3 previousP, vec3 previousN, vec3 probeDirection,
  RayTracingPayload probePayload, vec2 currentNDC,
  inout vec4 primaryAlbedo, inout vec4 primaryNormal, inout vec4 primaryThroughput,
  inout float ptDepth, inout vec2 ptMotion)
{
  // Every mirror of the chain, primary vertex first, with its plane as of the previous frame.
  vec3 mirrorNormals[PT_PSR_MAX_CHAIN_DEPTH];
  vec3 previousMirrorPoints[PT_PSR_MAX_CHAIN_DEPTH];
  vec3 previousMirrorNormals[PT_PSR_MAX_CHAIN_DEPTH];
  mirrorNormals[0] = N;
  previousMirrorPoints[0] = previousP;
  previousMirrorNormals[0] = previousN;
  int mirrorCount = 1;
  int maxMirrors = min(PT_PSR_MAX_CHAIN_DEPTH, pc.maxBounces);

  // The delta branch's expected weight, Fresnel. Its division by the lobe probability is the
  // estimator's business, not a property of the surface RR is told about.
  vec3 throughput = fresnelSchlick(NdotV, f0);
  float chainDistance = primaryDistance;
  vec3 segmentBase = P;
  // Where the segment's ray actually left from, which hitT is measured against.
  vec3 segmentOrigin = offsetRayOrigin(P, N);
  vec3 direction = probeDirection;
  RayTracingPayload hitPayload = probePayload;

  for (int link = 0; link < PT_PSR_MAX_CHAIN_DEPTH; link++)
  {
    if (hitPayload.hit == 0u)
    {
      // The sky through the chain: a direction at infinity, mirrored back across last frame's
      // planes the way the probe's own motion vector does it.
      vec3 previousDirection = direction;
      for (int i = mirrorCount - 1; i >= 0; i--)
        previousDirection = mirrorDirection(previousDirection, previousMirrorNormals[i]);

      primaryAlbedo = vec4(0.0);
      primaryNormal = vec4(0.0, 0.0, 0.0, 1.0);
      primaryThroughput = vec4(throughput, 0.0);
      ptDepth = PT_SKY_DEPTH;
      ptMotion = specularMotionFromPrevClip(
        u_Frame.prevProj * (u_Frame.prevView * vec4(previousDirection, 0.0)), currentNDC);
      return;
    }

    RayHitGeometry hit = resolveHitGeometry(hitPayload.instanceIndex, hitPayload.primitiveIndex,
      hitPayload.objectToWorld, hitPayload.barycentrics, direction);
    PathSurface surface = resolveHitMaterial(hit, hitPayload.barycentrics);
    vec4 hitDelta[3] = u_Instances[hitPayload.instanceIndex].worldToPrevWorld;

    // Based at the unoffset segment start for the same reason the probe's motion vector is:
    // the ray origin offset runs along the normal and would carry the point off the camera ray.
    // Only the offset's component along the ray is added back to hitT.
    float segmentLength = hitPayload.hitT + dot(segmentOrigin - segmentBase, direction);
    vec3 X = segmentBase + direction * segmentLength;
    chainDistance += segmentLength;
    vec3 previousX = applyWorldToPrevWorldPoint(hitDelta, X);

    bool isMirror = !surface.emissiveTexel
      && surface.roughness * surface.roughness <= PT_DELTA_MAX_ALPHA
      && surface.metallic >= PT_PSR_MIN_METALLIC;

    if (isMirror && mirrorCount < maxMirrors)
    {
      float hitNdotV = clamp(abs(dot(hit.normal, direction)), 0.01, 0.99);
      throughput *= fresnelSchlick(hitNdotV, mix(vec3(0.04), surface.albedo, surface.metallic));

      mirrorNormals[mirrorCount] = hit.normal;
      previousMirrorPoints[mirrorCount] = previousX;
      previousMirrorNormals[mirrorCount] = applyWorldToPrevWorldDirection(hitDelta, hit.normal);
      mirrorCount++;

      segmentBase = X;
      segmentOrigin = offsetRayOrigin(hit.position, hit.normal);
      direction = reflect(direction, hit.normal);

      payload.hit = 0u;
      traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_OPAQUE,
        0u, 0u, uint(PT_PRIMARY_MISS_INDEX),
        segmentOrigin, PT_RAY_TMIN, direction, PT_RAY_TMAX,
        0);
      hitPayload = payload;
      continue;
    }

    // The last mirror of the chain images the point first, the primary vertex last.
    vec3 virtualNormal = hit.normal;
    vec3 previousVirtual = previousX;
    for (int i = mirrorCount - 1; i >= 0; i--)
    {
      virtualNormal = mirrorDirection(virtualNormal, mirrorNormals[i]);
      previousVirtual = mirrorPoint(previousVirtual, previousMirrorPoints[i], previousMirrorNormals[i]);
    }

    bool hasPbrResponse = !surface.emissiveTexel;
    primaryAlbedo = vec4(surface.albedo, surface.metallic);
    primaryNormal = vec4(virtualNormal, hasPbrResponse ? surface.roughness : 1.0);
    primaryThroughput = vec4(throughput, hasPbrResponse ? 1.0 : 0.0);
    // Reversed-Z is near / viewZ, and viewZ grows linearly along the camera ray, so the virtual
    // point's depth is the primary depth scaled by the distance ratio - no reprojection, and
    // exact to the G-buffer's own value at a chain length of zero.
    ptDepth = depth * (primaryDistance / chainDistance);
    ptMotion = specularMotionFromPrevClip(
      u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtual, 1.0)), currentNDC);
    return;
  }
}

void main()
{
  ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
  if (pixel.x >= u_Frame.screenWidth || pixel.y >= u_Frame.screenHeight)
    return;

  vec2 uv = (vec2(pixel) + 0.5) / vec2(u_Frame.screenWidth, u_Frame.screenHeight);
  float depth = texture(u_Depth, uv).r;

  vec3 rayOrigin;
  vec3 rayDirection;
  primaryRay(pixel, rayOrigin, rayDirection);

  uint rngState = initRandomSeed(uvec2(gl_LaunchIDEXT.xy), uint(u_Frame.frameIndex));

  vec3 radiance = vec3(0.0);
  PathDebug pathDebug = PathDebug(0.0, -1.0, vec3(0.0), vec3(0.0));
  float primaryDistance = PT_SKY_DISTANCE;
  // What ray reconstruction wants in kBufferTypeSpecularHitDistance, per section 3.4.9 of
  // NVIDIA's DLSS-RR Integration Guide: the WORLD SPACE distance between a specular ray's
  // origin - which must lie on the primary surface - and its hit point. It synthesizes the
  // specular motion vectors from this plus the camera matrices, so anything else fed here
  // makes reflections boil rather than merely look approximate.
  //
  // Measured by a dedicated probe ray along the mirror direction, NOT by whichever bounce the
  // lobe coin happened to pick. Gating it on the coin made the guide stochastic: on a
  // dielectric the specular lobe is chosen about a quarter of the time, so three frames in
  // four the guide read zero - "the virtual reflection sits on the surface" - and the fourth
  // read a real distance. Ray reconstruction reprojected the reflection one way and then the
  // other, frame after frame, which is exactly the flicker that showed up on glass. The probe
  // costs one coherent ray per shaded pixel and has no variance at all.
  //
  // Zero stays the answer where there is no surface to reflect off: the sky, an unlit texel
  // and an emissive one, none of which reach the probe below.
  float specularHitDistance = 0.0;

  // Every virtual point this pixel can be given lies on the camera ray through it, so its current
  // unjittered projection is the pixel centre plus the jitter whatever its distance - the same
  // current NDC backgroundVelocity builds.
  vec2 pixelNDC = uv * 2.0 - 1.0;
  vec2 currentNDC = pixelNDC + vec2(u_Frame.jitterX, u_Frame.jitterY);
  vec2 specularMotion = vec2(0.0);

  // The first vertex as ray reconstruction is told about it. Defaults are the sky's; a surface
  // copies the G-buffer below, and Primary Surface Replacement overwrites all of it on a mirror.
  vec4 primaryAlbedo = vec4(0.0);
  vec4 primaryNormal = vec4(0.0, 0.0, 0.0, 1.0);
  vec4 primaryThroughput = vec4(1.0, 1.0, 1.0, 0.0);
  // Unfiltered copies for RR; the estimator keeps its own filtered reads.
  float ptDepth = texelFetch(u_Depth, pixel, 0).r;
  vec2 ptMotion = texelFetch(u_MainVelocity, pixel, 0).rg;

  // PROTOTYPE (dielectric reflection layer spike). A layer pixel is a smooth dielectric first
  // vertex: its mirror lobe is traced as a path of its own into layerRadiance, weighted by F -
  // the delta branch without the lobe coin - and the second RR instance is told about the
  // reflected surface. Everywhere else the layer first vertex copies the primary one.
  bool layerPixel = false;
  vec3 layerF = vec3(0.0);
  vec3 layerRadiance = vec3(0.0);
  vec4 layerAlbedo = vec4(0.0);
  vec4 layerNormal = vec4(0.0, 0.0, 0.0, 1.0);
  vec4 layerThroughput = vec4(1.0, 1.0, 1.0, 0.0);
  float layerDepth = PT_SKY_DEPTH;
  vec2 layerMotion = vec2(0.0);

  if (depth <= PT_SKY_DEPTH)
  {
    // The sky is not a surface: there is no vertex to shade and no path to start.
    radiance = texture(u_Skybox, rayDirection).rgb;
    specularMotion = backgroundVelocity(pixelNDC);
  }
  else
  {
    vec4 gb0 = texture(u_GBuffer0, uv);
    vec4 gb1 = texture(u_GBuffer1, uv);
    vec4 gb0Texel = texelFetch(u_GBuffer0, pixel, 0);
    vec4 gb1Texel = texelFetch(u_GBuffer1, pixel, 0);
    vec3 texelNormal = octDecode(gb1Texel.rg * 2.0 - 1.0);

    // The same reconstruction deferred_lighting.frag performs, out of the same reversed-Z
    // depth and the same inverse matrices.
    vec3 viewPos = reconstructViewPos(uv, depth);
    vec3 worldPos = (u_Frame.invView * vec4(viewPos, 1.0)).xyz;
    primaryDistance = length(worldPos - u_Frame.cameraPosition);

    int shadingModel = decodeShadingModel(gb1.a);
    // Full roughness unless the PBR branch says otherwise: the widest filter for a texel with
    // no lobe, exactly what the guides wrote for it before.
    primaryNormal = vec4(texelNormal, 1.0);

    if (shadingModel == SHADING_UNLIT)
    {
      // Unlit is the raster's own escape hatch - the albedo IS the final colour - so there
      // is nothing to integrate and the path stops before it starts.
      radiance = gb0.rgb;
      // Nothing is reflected, so the image moves with the surface itself.
      specularMotion = texelFetch(u_MainVelocity, pixel, 0).rg;
    }
    else if (shadingModel == SHADING_EMISSIVE)
    {
      // GBuffer0 holds encoded emission instead of albedo and metallic for this texel, and
      // an emissive texel has given up its PBR response, so it emits and nothing else.
      radiance = decodeEmissive(gb0);
      specularMotion = texelFetch(u_MainVelocity, pixel, 0).rg;
    }
    else
    {
      vec3 albedo = gb0.rgb;
      float metallic = gb0.a;
      float roughness = gb1.b;
      vec3 N = octDecode(gb1.rg * 2.0 - 1.0);

      primaryAlbedo = gb0Texel;
      primaryNormal = vec4(texelNormal, gb1Texel.b);
      primaryThroughput = vec4(1.0);
      vec3 P = worldPos;
      // The view vector deferred_lighting.frag builds, not -rayDirection: the two differ by
      // the pixel centre and the sub-pixel jitter, and matching the raster is the whole
      // reason this path starts from its G-buffer.
      vec3 V = normalize(u_Frame.cameraPosition - P);

      // The specular hit distance probe. Traced before the path starts and independently of
      // it, so the guide describes the surface rather than the sample: same origin the bounce
      // rays leave from, mirror direction, and nothing is shaded at the far end - the closest
      // hit shader writes the parametric distance and the path loop below never sees this
      // payload. Opaque flag deliberately absent so alpha-tested geometry cuts out here too,
      // otherwise a foliage card would report a reflection that is not there.
      {
        vec3 probeOrigin = offsetRayOrigin(P, N);
        vec3 probeDirection = reflect(-V, N);

        payload.hit = 0u;
        traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_OPAQUE,
          0u, 0u, uint(PT_PRIMARY_MISS_INDEX),
          probeOrigin, PT_RAY_TMIN, probeDirection, PT_RAY_TMAX,
          0);

        // A reflection that leaves the scene has its virtual image at infinity, which is what
        // the largest distance the R16F guide can carry says. A real hit is clamped to the
        // same ceiling so a far wall in a large scene cannot overflow fp16 into infinity.
        specularHitDistance = payload.hit == 0u
          ? PT_SPECULAR_MISS_DISTANCE
          : min(payload.hitT, PT_SPECULAR_MISS_DISTANCE);

        // Copied before anything else traces: the payload is shared, and the lookup below
        // overwrites it. hitT unclamped - the fp16 ceiling belongs to the guide image only.
        bool probeHit = payload.hit != 0u;
        float probeHitT = payload.hitT;
        uint probeInstanceIndex = payload.instanceIndex;
        RayTracingPayload probePayload = payload;

        // The G-buffer does not say which instance P belongs to, so the reflector is found by
        // tracing the camera ray to it. A hit that lands off the reconstructed depth found
        // something else, and the reflector is then taken as static.
        float lookupTolerance = primaryDistance * PT_REFLECTOR_LOOKUP_RELATIVE_TOLERANCE
          + PT_REFLECTOR_LOOKUP_ABSOLUTE_TOLERANCE;

        payload.hit = 0u;
        traceRayEXT(u_Tlas, gl_RayFlagsNoneEXT, RT_MASK_OPAQUE,
          0u, 0u, uint(PT_PRIMARY_MISS_INDEX),
          u_Frame.cameraPosition, PT_RAY_TMIN, (P - u_Frame.cameraPosition) / primaryDistance,
          primaryDistance + lookupTolerance,
          0);

        vec4 reflectorDelta[3] = WORLD_TO_PREV_WORLD_IDENTITY;
        if (payload.hit != 0u && abs(payload.hitT - primaryDistance) <= lookupTolerance)
          reflectorDelta = u_Instances[payload.instanceIndex].worldToPrevWorld;

        // N is the normal the probe direction was reflected about.
        vec3 previousP = applyWorldToPrevWorldPoint(reflectorDelta, P);
        vec3 previousN = applyWorldToPrevWorldDirection(reflectorDelta, N);

        vec4 previousClip;
        if (probeHit)
        {
          // Based at P, not at the probe origin: that offset runs along N, and mirroring would
          // carry it off the camera ray - a constant bias even on a frame where nothing moves.
          // hitT runs from the probe origin, so the offset's component along the ray is added.
          vec3 X = P + probeDirection * (probeHitT + dot(probeOrigin - P, probeDirection));
          vec3 previousX = applyWorldToPrevWorldPoint(
            u_Instances[probeInstanceIndex].worldToPrevWorld, X);
          vec3 previousVirtual = mirrorPoint(previousX, previousP, previousN);
          previousClip = u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtual, 1.0));
        }
        else
        {
          // The environment sits at infinity and does not move, so only the reflected
          // direction follows the reflector.
          vec3 previousVirtualDirection = mirrorDirection(probeDirection, previousN);
          previousClip = u_Frame.prevProj * (u_Frame.prevView * vec4(previousVirtualDirection, 0.0));
        }

        specularMotion = specularMotionFromPrevClip(previousClip, currentNDC);

        if (roughness * roughness <= PT_DELTA_MAX_ALPHA && metallic >= PT_PSR_MIN_METALLIC)
        {
          replacePrimarySurface(P, N, mix(vec3(0.04), albedo, metallic),
            clamp(abs(dot(N, V)), 0.01, 0.99), depth, primaryDistance, previousP, previousN,
            probeDirection, probePayload, currentNDC,
            primaryAlbedo, primaryNormal, primaryThroughput, ptDepth, ptMotion);
          // On a replaced pixel the reflection is the surface RR is told about: the two motion
          // tags agree, and ptDepth already sits at the reflected hit, so no reflection distance
          // is left beyond it.
          specularMotion = ptMotion;
          specularHitDistance = 0.0;
        }
        else if (roughness * roughness <= PT_DELTA_MAX_ALPHA)
        {
          // PROTOTYPE (dielectric reflection layer spike): the metallic PSR machinery, pointed
          // at the layer first vertex instead of the primary one. f0 and NdotV exactly as the
          // bounce loop builds them, so layerF is the delta branch's weight.
          vec3 layerF0 = mix(vec3(0.04), albedo, metallic);
          float layerNdotV = clamp(abs(dot(N, V)), 0.01, 0.99);
          layerPixel = true;
          layerF = fresnelSchlick(layerNdotV, layerF0);
          replacePrimarySurface(P, N, layerF0, layerNdotV, depth, primaryDistance, previousP,
            previousN, probeDirection, probePayload, currentNDC,
            layerAlbedo, layerNormal, layerThroughput, layerDepth, layerMotion);
#if PT_LAYER_F_IN_COMPOSITE
          // F rides the RR colour alpha instead of the guides.
          layerThroughput.rgb /= max(layerF, vec3(1e-4));
#endif
        }
      }

      // PROTOTYPE (dielectric reflection layer spike): a layer pixel runs the loop twice from the
      // same first vertex - pass 0 the base path (NEE and the diffuse lobe), pass 1 the mirror
      // path - so both lobes are sampled every frame instead of one by the coin. The expected
      // value is the coin's: each lobe keeps its weight and only loses the 1 / p it paid for
      // being picked. Pass 1's radiance is moved into layerRadiance afterwards.
      PathSettings pathSettings = PathSettings(pc.maxBounces, pc.fireflyClamp,
        pc.debugMode == PT_DEBUG_NONFINITE);
      int pathPasses = layerPixel ? 2 : 1;

      for (int pathPass = 0; pathPass < pathPasses; pathPass++)
      {
        int firstVertex = !layerPixel ? PT_FIRST_VERTEX_COIN
          : (pathPass == 0 ? PT_FIRST_VERTEX_BASE : PT_FIRST_VERTEX_MIRROR);
        vec3 passRadianceStart = radiance;

        tracePath(P, N, V, albedo, metallic, roughness, vec3(1.0), pathSettings, firstVertex,
          rngState, radiance, pathDebug);

        if (pathPass == 1)
        {
          layerRadiance = radiance - passRadianceStart;
          radiance = passRadianceStart;
        }
      }
    }
  }

  // Last line of defence, and the reason it is worth its two instructions: the accumulation
  // image is read-modify-written, so one NaN reaching it is blended into every later sample
  // and that pixel stays poisoned for the rest of the run.
  if (any(isnan(radiance)) || any(isinf(radiance)))
    radiance = vec3(0.0);
  if (any(isnan(layerRadiance)) || any(isinf(layerRadiance)))
    layerRadiance = vec3(0.0);

  // Ahead of the debug returns below: the guide pass and ray reconstruction still run while a
  // diagnostic is selected, and they read these rather than the G-buffer.
  imageStore(outPrimaryAlbedo, pixel, primaryAlbedo);
  imageStore(outPrimaryNormal, pixel, primaryNormal);
  imageStore(outPrimaryThroughput, pixel, primaryThroughput);
  imageStore(outPTDepth, pixel, vec4(ptDepth));
  imageStore(outPTMotion, pixel, vec4(ptMotion, 0.0, 0.0));

  // PROTOTYPE (dielectric reflection layer spike)
  if (!layerPixel)
  {
    layerAlbedo = primaryAlbedo;
    layerNormal = primaryNormal;
    layerThroughput = primaryThroughput;
    layerDepth = ptDepth;
    layerMotion = ptMotion;
  }

  vec4 layerOut = vec4(0.0);
  if (layerPixel)
  {
#if PT_LAYER_F_IN_COMPOSITE
    // Unweighted reflection, F in alpha for RR's alpha upscaling and the composite. The path was
    // traced with F in its throughput so the firefly clamp and Russian roulette see exactly what
    // the estimator's delta branch sees; it is divided back out here.
    layerOut = vec4(layerRadiance / max(layerF, vec3(1e-4)), layerF.g);
#else
    layerOut = vec4(layerRadiance, 1.0);
#endif
  }

  imageStore(outLayerRadiance, pixel, layerOut);
  imageStore(outLayerAlbedo, pixel, layerAlbedo);
  imageStore(outLayerNormal, pixel, layerNormal);
  imageStore(outLayerThroughput, pixel, layerThroughput);
  imageStore(outLayerDepth, pixel, vec4(layerDepth));
  imageStore(outLayerMotion, pixel, vec4(layerMotion, 0.0, 0.0));

  // The diagnostics ride the noisy image rather than a target of their own: it is already
  // RGBA16F at render resolution and the tone map already samples it, so a debug view costs
  // no allocation. The accumulation store below is skipped entirely while one is selected -
  // blending a diagnostic into the running mean would be meaningless.
  //
  // Stored as a PLAIN base-10 logarithm with a floor, not as log(1 + x). The values worth
  // reading here straddle one: a correct contribution sits near it and a broken one sits
  // several orders above, so the scale has to resolve both directions. log(1 + x) compresses
  // everything below one into almost nothing and would render the entire useful lower half of
  // the range as a single shade. The floor at 1e-4 is what keeps the logarithm finite at zero
  // and fixes the bottom of the scale; PT_DEBUG_LOG_MIN and _MAX bound it on both sides.
  // Raw integers, deliberately NOT on the log ramp the block below uses: this view is read
  // back numerically out of the captured image, so the code has to survive the round trip
  // exactly. R is the PT_NF_* code, G the bounce it fired on, -1 where nothing fired.
  if (pc.debugMode == PT_DEBUG_NONFINITE)
  {
    imageStore(outNoisy, pixel,
      vec4(float(g_NonFiniteCode), float(g_NonFiniteBounce), 0.0, 0.0));
    return;
  }

  if (pc.debugMode != PT_DEBUG_OFF)
  {
    vec3 value = vec3(pathDebug.maxContribution);
    if (pc.debugMode == PT_DEBUG_NEE)
      value = pathDebug.nee;
    else if (pc.debugMode == PT_DEBUG_ENVIRONMENT)
      value = pathDebug.environment;

    float magnitude = max(value.r, max(value.g, value.b));
    float logMagnitude = log(max(magnitude, PT_DEBUG_LOG_FLOOR)) / log(10.0);
    imageStore(outNoisy, pixel, vec4(vec3(logMagnitude), pathDebug.maxBounce));
    return;
  }

  imageStore(outNoisy, pixel, vec4(radiance, primaryDistance));
  imageStore(outHitDistance, pixel, vec4(specularHitDistance));
  imageStore(outSpecularMotion, pixel, vec4(specularMotion, 0.0, 0.0));

  if (pc.sampleIndex >= 0)
  {
    // PROTOTYPE (dielectric reflection layer spike): the reference is base + layer, which is
    // the coin estimator's expectation - see the path split above.
    vec3 fullRadiance = radiance + layerRadiance;
    vec4 accumulated = vec4(fullRadiance, 1.0);

    if (pc.sampleIndex > 0)
    {
      // Running mean, so the reference image converges without the CPU ever reading it
      // back: sample n is blended in at 1 / (n + 1). Index zero rewrites the image
      // outright, which IS the reset - the buffer never has to be cleared.
      vec4 previous = imageLoad(outAccumulation, pixel);
      float blend = 1.0 / float(pc.sampleIndex + 1);
      accumulated = mix(previous, vec4(fullRadiance, 1.0), blend);
    }

    imageStore(outAccumulation, pixel, accumulated);
  }
}
