#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#ifdef RT_BINDLESS
// Only the bindless permutation declares the runtime-sized sampler array and indexes it
// non-uniformly, and only it may: both need descriptor indexing features the base
// permutation must run without. That is why this is a permutation and not a specialization
// constant - a spec constant can switch off a branch, but the descriptor declaration and
// the set 2 the pipeline layout needs would still be in the module.
#extension GL_EXT_nonuniform_qualifier : require
#endif

layout(local_size_x = 8, local_size_y = 8) in;

// Carries the set 1 and set 2 declarations, the mesh stream helpers and shadeDebugHit,
// which pathtrace.rgen calls with the same arguments - that is what keeps the two views
// pixel-identical. RT_DEBUG_VIEW is what claims set 1 binding 3 as the output image; the
// path tracer forks the layout there and must not declare it.
#define RT_DEBUG_VIEW
#include "raytracing_common.glsl"

void main()
{
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (pixel.x >= u_Frame.screenWidth || pixel.y >= u_Frame.screenHeight)
    return;

  vec3 rayOrigin;
  vec3 rayDirection;
  primaryRay(pixel, rayOrigin, rayDirection);

  rayQueryEXT rayQuery;
  rayQueryInitializeEXT(rayQuery, u_Tlas, gl_RayFlagsOpaqueEXT, RT_MASK_OPAQUE,
    rayOrigin, RT_DEBUG_TMIN, rayDirection, RT_DEBUG_TMAX);

  // Forcing every candidate opaque leaves nothing for the shader to resolve, so this
  // returns false on the first call. It stays a loop because that is the traversal
  // contract, and the any-hit alpha cutout will need it.
  while (rayQueryProceedEXT(rayQuery)) {}

  vec3 color = RT_DEBUG_MISS_COLOR;

  if (rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
  {
    color = shadeDebugHit(
      uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true)),
      uint(rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true)),
      rayQueryGetIntersectionObjectToWorldEXT(rayQuery, true),
      rayQueryGetIntersectionBarycentricsEXT(rayQuery, true),
      rayDirection);
  }

  imageStore(outRayQuery, pixel, vec4(color, 1.0));
}
