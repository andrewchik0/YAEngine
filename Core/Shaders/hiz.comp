layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
  int srcMip;
  int dstWidth;
  int dstHeight;
  int srcWidth;
  int srcHeight;
} pc;

layout(set = 0, binding = 0) uniform sampler2D inputMip;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outputMip;

void main()
{
  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
  if (pos.x >= pc.dstWidth || pos.y >= pc.dstHeight) return;

  // srcMip < 0: 1:1 copy from depth buffer to Hi-Z mip 0
  if (pc.srcMip < 0)
  {
    imageStore(outputMip, pos, vec4(texelFetch(inputMip, pos, 0).r));
    return;
  }

  ivec2 srcSize = ivec2(pc.srcWidth, pc.srcHeight);
  ivec2 srcMax = srcSize - 1;
  ivec2 base = pos * 2;

  float minDepth = texelFetch(inputMip, min(base, srcMax), pc.srcMip).r;
  minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(1, 0), srcMax), pc.srcMip).r);
  minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(0, 1), srcMax), pc.srcMip).r);
  minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(1, 1), srcMax), pc.srcMip).r);

  // An odd source extent leaves a trailing row/column that a plain 2x2 reduction drops, so the
  // last destination texel along that axis would not be a true minimum of the region it covers.
  // The SSR traversal relies on that minimum being conservative: an understated cell reads as
  // empty and the ray marches straight past real geometry.
  bool extraX = (pc.srcWidth & 1) != 0 && pos.x == pc.dstWidth - 1;
  bool extraY = (pc.srcHeight & 1) != 0 && pos.y == pc.dstHeight - 1;

  if (extraX)
  {
    minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(2, 0), srcMax), pc.srcMip).r);
    minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(2, 1), srcMax), pc.srcMip).r);
  }
  if (extraY)
  {
    minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(0, 2), srcMax), pc.srcMip).r);
    minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(1, 2), srcMax), pc.srcMip).r);
  }
  if (extraX && extraY)
    minDepth = min(minDepth, texelFetch(inputMip, min(base + ivec2(2, 2), srcMax), pc.srcMip).r);

  imageStore(outputMip, pos, vec4(minDepth));
}
